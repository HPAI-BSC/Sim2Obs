BootStrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%post
    export CUDA_HOME=/usr/local/cuda
    apt update -y
    apt install rsync -y
    apt install -y software-properties-common
    add-apt-repository ppa:deadsnakes/ppa -y
    apt update -y
    apt-get install -y git
    apt install -y curl
    apt install -y python3.10
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
    apt install -y python3.10-venv python3.10-dev
    apt install nvidia-cuda-toolkit -y
    curl -Ss https://bootstrap.pypa.io/get-pip.py | python3.10

    apt-get clean
    rm -rf /var/lib/apt/lists/

    apt-key adv --fetch-keys http://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/x86_64/7fa2af80.pub

    pip3 install illustris_python git+https://github.com/illustristng/illustris_python@b7bc432e994ce057f30ee135ca9d43654d60f14d
    pip3 install antlr4-python3-runtime==4.9.3
    pip3 install attr==0.3.1
    pip3 install attrs==23.1.0
    pip3 install beautifulsoup4==4.12.2
    pip3 install bleach==5.0.1
    pip3 install certifi==2023.5.7
    pip3 install charset-normalizer==3.2.0
    pip3 install contourpy==1.2.0
    pip3 install cycler==0.12.1
    pip3 install defusedxml==0.7.1
    pip3 install fastjsonschema==2.17.1
    pip3 install fonttools==4.47.2
    pip3 install h5py==3.9.0
    pip3 install hydra-core==1.3.2
    pip3 install idna==3.4
    pip3 install iniconfig==2.0.0
    pip3 install joblib==1.3.2
    pip3 install jsonschema==4.23.0
    pip3 install jsonschema-specifications==2023.7.1
    pip3 install kiwisolver==1.4.5
    pip3 install MarkupSafe==2.1.5
    pip3 install matplotlib==3.9.2
    pip3 install mistune==3.0.1
    pip3 install nbclient==0.8.0
    pip3 install nbconvert==7.7.3
    pip3 install nbformat==5.9.2
    pip3 install numpy==1.24.3
    pip3 install omegaconf==2.3.0
    pip3 install packaging==23.1
    pip3 install pandas==1.5.3
    pip3 install pandocfilters==1.5.0
    pip3 install pillow==10.2.0
    pip3 install platformdirs==3.9.1
    pip3 install pluggy==1.5.0
    pip3 install Pygments==2.15.1
    pip3 install pyparsing==2.4.7
    pip3 install pytest==8.3.3
    pip3 install python-dateutil==2.8.2
    pip3 install pytz==2023.4
    pip3 install PyYAML==6.0.2
    pip3 install pyzmq==25.1.0
    pip3 install referencing==0.30.0
    pip3 install rpds-py==0.9.2
    pip3 install scikit-base==0.5.2
    pip3 install scikit-learn==1.2.2
    pip3 install scikit-plot==0.3.7
    pip3 install scipy==1.13.1
    pip3 install six==1.16.0
    pip3 install soupsieve==2.4.1
    pip3 install threadpoolctl==3.2.0
    pip3 install tinycss2==1.2.1
    pip3 install tomli==2.0.1
    pip3 install tornado==6.3.2
    pip3 install traitlets==5.9.0
    pip3 install tzdata==2023.3
    pip3 install urllib3==1.26.18
    pip3 install webencodings==0.5.1
    pip3 install zipp==3.16.2
    pip3 install python-dotenv
    pip3 install eagleSqlTools
    pip3 install hydra_colorlog

    # Step 2: Remove unneeded dependencies
    apt-get autoremove -y

    # Step 3: Clean up the package cache
    apt-get autoclean

    mkdir -p "/home"
    pwd
    pip freeze
    which pip

%environment
# Set any environment variables if required

%runscript
# Add a runscript if needed

%labels
    Pablo Agustin Martin Torres
    Institution Barcelona Supercomputing Center
