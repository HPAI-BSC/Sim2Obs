BootStrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%post
    export CUDA_HOME=/usr/local/cuda
    apt update -y
    apt install rsync -y
    apt install -y software-properties-common
    add-apt-repository ppa:deadsnakes/ppa -y
    apt update -y
    apt-get install -y git
    apt install -y curl
    apt install -y python3.10
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
    apt install -y python3.10-venv python3.10-dev
    apt install nvidia-cuda-toolkit -y
    curl -Ss https://bootstrap.pypa.io/get-pip.py | python3.10
    apt-get clean
    rm -rf /var/lib/apt/lists/

    apt-key adv --fetch-keys http://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/x86_64/7fa2af80.pub

    pip3 install torch==2.1.2 torchvision==0.16.2 torchaudio==2.1.2 --index-url https://download.pytorch.org/whl/cu118
    pip3 install lightning==2.2.1
    pip3 install torchmetrics==1.3.2
    pip3 install hydra-core==1.3.2
    pip3 install hydra-colorlog==1.2.0
    pip3 install hydra-optuna-sweeper==1.2.0
    pip3 install --ignore-installed mlflow
    pip3 install pytest
    pip3 install rootutils
    pip3 install pre-commit
    pip3 install rich
    pip3 install pydantic==1.10.11
    pip3 install websockets
    pip3 install einops
    pip3 install mamba-ssm
    pip3 install timm
    pip3 install fvcore

    mkdir -p "/home"
    pwd
    pip freeze
    which pip

%environment
# Set any environment variables if required

%runscript
# Add a runscript if needed

%labels
    Pablo Agustin Martin Torres
    Institution Barcelona Supercomputing Center
